# Gerado localmente por install.sh
claude/settings.json

# Backups locais de config — ruido, nao versionar
claude/settings.json.bak*
claude/settings.json.pre-*
claude/settings.template.json.pre-*
.gitignore.pre-*

# Plugins: marketplaces e caches sao baixados/regenerados pelo Claude Code.
# installed_plugins.json e known_marketplaces.json ficam versionados de proposito —
# sao a lista do que reinstalar numa maquina nova.
claude/plugins/marketplaces/
claude/plugins/cache/
claude/plugins/data/
claude/plugins/blocklist.json
claude/plugins/plugin-catalog-cache.json
claude/plugins/install-counts-cache.json
claude/plugins/.gcs-sha

# Runtime flags / caches
claude/mcp-needs-auth-cache.json

# Dados sensiveis / volumosos — nunca commitar
claude/memory/
claude/cache/
claude/statsig/
claude/sessions/
claude/history.jsonl
claude/*.log
claude/hook-approvals.log
claude/debug/
claude/downloads/
claude/paste-cache/
claude/shell-snapshots/
claude/stats-cache.json
claude/telemetry/
claude/todos/
claude/tasks/
claude/ide/
claude/ccline/
claude/projects/
claude/image-cache/
claude/file-history/
claude/session-env/
claude/backups/

# Skills instaladas por ferramenta (regeneraveis: `gitnexus setup -c claude`)
claude/skills/gitnexus-*/

# Archives locais — historico morto, nao precisa viajar entre maquinas
claude/skills-archive/
claude/hooks-archive/
claude/commands-archived/
claude/devflow-lite/
claude/trash-*/

# Estado de runtime
claude/daemon/
claude/jobs/
claude/docs/
claude/.last-cleanup
claude/.last-update-result.json
claude/plugins/.last_inuse_sweep

# Caches de ferramenta
.pytest_cache/
.ruff_cache/
__pycache__/

# Secrets
**/.env
**/.env.local
**/*.key
**/*.pem

# macOS
.DS_Store
