#!/usr/bin/env bash
# wt-gc — garbage collector for git worktrees and their build artifacts.
#
# Classifies every worktree of a repo into one of three buckets, based on
# evidence only. Nothing is removed unless it proves it holds no work.
#
#   SAFE      clean tree, no unpushed commits, branch merged into an integration
#             branch (or detached at a commit already contained in one).
#             -> whole worktree can be removed.
#   ARTIFACTS worktree still holds work, but its build output does not.
#             -> only build/, .dart_tool/, node_modules/, Pods/, DerivedData/
#                are removed. Regenerated by pub get / npm ci / pod install.
#   KEEP      dirty tree, unpushed commits, or unmerged branch.
#             -> untouched.
#
# Default is a dry run. Pass --apply to act.
#
# Usage:
#   wt-gc <repo-path> [--apply] [--artifacts-only] [--min-age-days N]

set -uo pipefail

REPO="${1:-}"
[ -z "$REPO" ] && { echo "usage: wt-gc <repo-path> [--apply] [--artifacts-only] [--min-age-days N]" >&2; exit 2; }
shift

APPLY=0
ARTIFACTS_ONLY=0
MIN_AGE_DAYS=0
INTEGRATION_BRANCHES="develop main master"

while [ $# -gt 0 ]; do
  case "$1" in
    --apply)          APPLY=1 ;;
    --artifacts-only) ARTIFACTS_ONLY=1 ;;
    --min-age-days)   shift; MIN_AGE_DAYS="$1" ;;
    *) echo "unknown flag: $1" >&2; exit 2 ;;
  esac
  shift
done

# GIT_DIR leaking in from a parent process silently retargets every git call
# at the wrong repo, which is how a worktree gets judged against foreign refs.
unset GIT_DIR GIT_WORK_TREE

cd "$REPO" 2>/dev/null || { echo "not a directory: $REPO" >&2; exit 2; }
git rev-parse --git-dir >/dev/null 2>&1 || { echo "not a git repo: $REPO" >&2; exit 2; }

# Entries may be a bare name (node_modules) or a subpath (tmp/cache). The subpath
# form matters for Rails: tmp/ as a whole holds pids and sockets that a running
# server depends on, so only the cache below it is collectable.
ARTIFACT_DIRS="build .dart_tool node_modules Pods DerivedData .symlinks
               .venv venv .next .turbo dist __pycache__ .pytest_cache
               .mypy_cache .ruff_cache target coverage
               .gitnexus log tmp/cache"

# A directory only counts as an artifact when git tracks nothing inside it.
# That is the real guarantee: a committed dist/ or a vendored build/ has tracked
# files and is left alone, while a .venv/ that is merely missing from .gitignore
# still holds nothing versioned and is safe to drop. Testing check-ignore instead
# would spare the committed dist/ but also spare every un-ignored .venv/, which
# is where most of the space actually sits.
has_no_tracked_files() {
  local wt="$1" d="$2"
  [ -z "$(git -C "$wt" ls-files -- "$d" 2>/dev/null | head -1)" ]
}

MAIN_WT="$(git worktree list --porcelain | awk '/^worktree /{print $2; exit}')"

# Resolve which integration branches actually exist, preferring remotes so the
# check reflects what was really pushed rather than a stale local ref.
INTEGRATION_REFS=""
for b in $INTEGRATION_BRANCHES; do
  if git rev-parse --verify --quiet "origin/$b" >/dev/null; then
    INTEGRATION_REFS="$INTEGRATION_REFS origin/$b"
  elif git rev-parse --verify --quiet "$b" >/dev/null; then
    INTEGRATION_REFS="$INTEGRATION_REFS $b"
  fi
done
[ -z "$INTEGRATION_REFS" ] && { echo "no develop/main/master found in $REPO; refusing to classify" >&2; exit 3; }

human() { awk -v k="$1" 'BEGIN{ if (k>1048576) printf "%.1fG", k/1048576; else printf "%.0fM", k/1024 }'; }

artifact_kb() {
  local wt="$1" total=0 s
  for a in $ARTIFACT_DIRS; do
    while IFS= read -r d; do
      has_no_tracked_files "$wt" "$d" || continue
      s=$(du -sk "$d" 2>/dev/null | awk '{print $1}')
      [ -n "$s" ] && total=$((total + s))
    done < <(find "$wt" -maxdepth 3 -path "*/$a" -type d -prune 2>/dev/null)
  done
  echo "$total"
}

purge_artifacts() {
  local wt="$1"
  for a in $ARTIFACT_DIRS; do
    while IFS= read -r d; do
      has_no_tracked_files "$wt" "$d" || continue
      [ "$APPLY" -eq 1 ] && rm -rf "$d"
    done < <(find "$wt" -maxdepth 3 -path "*/$a" -type d -prune 2>/dev/null)
  done
}

printf "%-9s %10s  %-42s %s\n" "VERDICT" "ARTIFACTS" "WORKTREE" "REASON"
printf '%s\n' "--------------------------------------------------------------------------------------------------"

SAFE_KB=0; ART_KB=0; KEEP_KB=0
SAFE_LIST=(); ART_LIST=()

while IFS= read -r wt; do
  [ "$wt" = "$MAIN_WT" ] && continue
  [ -d "$wt" ] || continue

  akb=$(artifact_kb "$wt")

  # A worktree touched recently is assumed live regardless of git state.
  if [ "$MIN_AGE_DAYS" -gt 0 ]; then
    if [ -n "$(find "$wt" -maxdepth 1 -newermt "-${MIN_AGE_DAYS} days" -print -quit 2>/dev/null)" ]; then
      printf "%-9s %10s  %-42s %s\n" "KEEP" "$(human "$akb")" "$(basename "$wt")" "touched < ${MIN_AGE_DAYS}d ago"
      KEEP_KB=$((KEEP_KB + akb)); continue
    fi
  fi

  dirty="$(git -C "$wt" status --porcelain 2>/dev/null | head -1)"
  if [ -n "$dirty" ]; then
    printf "%-9s %10s  %-42s %s\n" "ARTIFACTS" "$(human "$akb")" "$(basename "$wt")" "uncommitted changes"
    ART_KB=$((ART_KB + akb)); ART_LIST+=("$wt"); continue
  fi

  head_sha="$(git -C "$wt" rev-parse HEAD 2>/dev/null)"
  branch="$(git -C "$wt" symbolic-ref --quiet --short HEAD 2>/dev/null)"

  if [ -n "$branch" ]; then
    upstream="$(git -C "$wt" rev-parse --abbrev-ref --quiet "@{upstream}" 2>/dev/null)"
    if [ -z "$upstream" ]; then
      # No upstream: the commits exist only here unless an integration branch
      # already contains them.
      contained=0
      for ref in $INTEGRATION_REFS; do
        git merge-base --is-ancestor "$head_sha" "$ref" 2>/dev/null && { contained=1; break; }
      done
      if [ "$contained" -eq 0 ]; then
        printf "%-9s %10s  %-42s %s\n" "KEEP" "$(human "$akb")" "$(basename "$wt")" "branch $branch never pushed"
        KEEP_KB=$((KEEP_KB + akb)); continue
      fi
    else
      ahead="$(git -C "$wt" rev-list --count "$upstream..HEAD" 2>/dev/null || echo 0)"
      if [ "${ahead:-0}" -gt 0 ]; then
        printf "%-9s %10s  %-42s %s\n" "KEEP" "$(human "$akb")" "$(basename "$wt")" "$ahead commit(s) not pushed"
        KEEP_KB=$((KEEP_KB + akb)); continue
      fi
    fi
  fi

  merged=""
  for ref in $INTEGRATION_REFS; do
    if git merge-base --is-ancestor "$head_sha" "$ref" 2>/dev/null; then merged="$ref"; break; fi
  done

  if [ -n "$merged" ]; then
    printf "%-9s %10s  %-42s %s\n" "SAFE" "$(human "$akb")" "$(basename "$wt")" "merged into $merged"
    SAFE_KB=$((SAFE_KB + akb)); SAFE_LIST+=("$wt")
  else
    printf "%-9s %10s  %-42s %s\n" "ARTIFACTS" "$(human "$akb")" "$(basename "$wt")" "pushed, not merged yet"
    ART_KB=$((ART_KB + akb)); ART_LIST+=("$wt")
  fi
done < <(git worktree list --porcelain | awk '/^worktree /{print $2}')

echo
echo "SAFE      ${#SAFE_LIST[@]} worktrees, $(human "$SAFE_KB") of artifacts (whole worktree removable)"
echo "ARTIFACTS ${#ART_LIST[@]} worktrees, $(human "$ART_KB") of artifacts (code kept)"
echo "KEEP      $(human "$KEEP_KB") of artifacts left untouched"

if [ "$APPLY" -eq 0 ]; then
  echo
  echo "dry run. re-run with --apply to act."
  exit 0
fi

# bash 3.2 (what macOS ships) expands "${arr[@]}" of an empty array to an unbound
# variable under set -u, which aborts the script before the prune below. Guard on
# length rather than dropping set -u, which is what catches real typos here.
if [ "${#ART_LIST[@]}" -gt 0 ]; then
  for wt in "${ART_LIST[@]}"; do purge_artifacts "$wt"; done
fi

if [ "${#SAFE_LIST[@]}" -gt 0 ]; then
  if [ "$ARTIFACTS_ONLY" -eq 0 ]; then
    for wt in "${SAFE_LIST[@]}"; do
      git worktree remove --force "$wt" 2>/dev/null || rm -rf "$wt"
    done
  else
    for wt in "${SAFE_LIST[@]}"; do purge_artifacts "$wt"; done
  fi
fi

git worktree prune
echo "done."
