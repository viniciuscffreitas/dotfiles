{
  "skillListingBudgetFraction": 0.04,
  "env": {
    "CLAUDE_CODE_NO_FLICKER": "1",
    "CLAUDE_CODE_DISABLE_1M_CONTEXT": "1",
    "CLAUDE_CODE_DISABLE_FEEDBACK_SURVEY": "1",
    "CLAUDE_CODE_RESUME_INTERRUPTED_TURN": "1",
    "CLAUDE_AUTO_BACKGROUND_TASKS": "1",
    "OP_SERVICE_ACCOUNT_TOKEN": "__OP_SERVICE_ACCOUNT_TOKEN__"
  },
  "permissions": {
    "allow": [
      "Bash(gh pr list:*)",
      "Bash(dart analyze:*)",
      "Bash(git -C __HOME__/Desktop/cisnebranco_web status)",
      "Bash(git -C __HOME__/Desktop/cisnebranco_web log main..HEAD --oneline)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git -C __HOME__/Desktop/cisnebranco_web push -u origin feature/instant-photo-confirmation)",
      "Bash(git -C __HOME__/Desktop/cisnebranco_web pull --rebase origin feature/instant-photo-confirmation)",
      "Skill(pr-review-toolkit:review-pr)",
      "Bash(git push:*)",
      "Bash(gh pr view:*)",
      "Bash(gh pr checks:*)",
      "Bash(gh pr merge:*)",
      "Bash(git fetch:*)",
      "Bash(git merge:*)",
      "Bash(git checkout:*)",
      "Bash(git pull:*)",
      "Bash(gh pr:*)",
      "Bash(flutter analyze:*)",
      "Bash(gh run list:*)",
      "Bash(gh run view:*)",
      "Bash(gh run watch:*)",
      "Bash(xargs:*)",
      "WebSearch",
      "Bash(gh run rerun:*)",
      "Bash(git show:*)",
      "Bash(gh workflow:*)",
      "Bash(find:*)",
      "Bash(mvn test:*)",
      "Bash(curl:*)",
      "Bash(python3:*)",
      "Bash(pip3 install:*)",
      "Bash(/tmp/xlvenv/bin/pip install:*)",
      "Bash(/tmp/xlvenv/bin/python3:*)",
      "Bash(mvn compile:*)",
      "Bash(./mvnw test:*)",
      "Bash(mvn clean test:*)",
      "Bash(docker info:*)",
      "Bash(open:*)",
      "Bash(dart run build_runner build:*)",
      "Bash(git stash:*)",
      "Bash(grep:*)",
      "Bash(./mvnw compile test-compile:*)",
      "Bash(ls:*)",
      "Bash(mvn verify:*)",
      "Bash(flutter build web:*)",
      "Bash(gh repo list:*)",
      "Bash(echo:*)",
      "Bash(git -C __HOME__/Desktop/cb log --oneline -20)",
      "Bash(git -C __HOME__/Desktop/cisnebranco_web log --oneline -20)",
      "Bash(cat:*)",
      "Bash(flutter test:*)",
      "Bash(flutter pub get:*)",
      "Bash(./mvnw compile:*)",
      "Bash(dart --version:*)",
      "Bash(docker ps:*)",
      "Bash(ssh:*)",
      "Bash(mvn:*)",
      "Bash(git -C __HOME__/Desktop/cisnebranco_web checkout main)",
      "Bash(git -C __HOME__/Desktop/cisnebranco_web pull)",
      "Bash(git -C __HOME__/Desktop/cisnebranco_web checkout -b feat/p0-5-sse-reconnect-banner)",
      "Bash(git -C __HOME__/Desktop/cisnebranco_web status --short lib/core/router/)",
      "Bash(./gradlew compileJava:*)",
      "Bash(__HOME__/Desktop/cb/gradlew compileJava:*)",
      "Bash(git -C __HOME__/Desktop/cb add src/main/java/com/cisnebranco/dto/request/TechnicalOsFilterRequest.java src/main/java/com/cisnebranco/specification/TechnicalOsSpecification.java src/main/java/com/cisnebranco/service/TechnicalOsService.java src/main/java/com/cisnebranco/controller/TechnicalOsController.java)",
      "Bash(git -C:*)",
      "Bash(git -C __HOME__/Desktop/cb push -u origin feat/p2-16-os-history-per-pet)",
      "Bash(git restore:*)",
      "Bash(git rebase:*)",
      "Bash(done)",
      "Bash(gh search:*)",
      "Bash(npm install:*)",
      "Bash(linear auth:*)",
      "Bash(npx:*)",
      "Bash(wc:*)"
    ],
    "deny": [
      "Agent(Explore)"
    ],
    "defaultMode": "bypassPermissions"
  },
  "model": "opus",
  "skillOverrides": {
    "vini-dream": "off",
    "vini-unknowns": "off"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Grep|Glob|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"__HOME__/.claude/hooks/gitnexus/gitnexus-hook.cjs\"",
            "timeout": 10,
            "statusMessage": "Enriching with GitNexus graph context..."
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 __HOME__/Developer/vini-personal/hooks/momease_prod_guard.py"
          }
        ]
      },
      {
        "matcher": "slack_send_message$",
        "hooks": [
          {
            "type": "command",
            "command": "python3 __HOME__/Developer/vini-personal/hooks/slack_draft_guard.py"
          }
        ]
      },
      {
        "matcher": "save_comment$",
        "hooks": [
          {
            "type": "command",
            "command": "python3 __HOME__/Developer/vini-personal/hooks/linear_comment_gate.py"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "# sounds.sh: soundsh/minecraft-villager-hmm\nafplay \"__HOME__/.claude/sounds/soundsh--minecraft-villager-hmm.mp3\"",
            "async": true
          }
        ]
      },
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 __HOME__/Developer/vini-personal/hooks/prompt_preamble.py"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"__HOME__/Developer/agent-tab-title/bin/agent-tab-title.js\" claude"
          }
        ]
      }
    ],
    "Notification": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "# sounds.sh: soundsh/minecraft-hurt\nafplay \"__HOME__/.claude/sounds/soundsh--minecraft-hurt.mp3\"",
            "async": true
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"__HOME__/Developer/agent-tab-title/bin/agent-tab-title.js\" claude"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"__HOME__/.claude/hooks/gitnexus/gitnexus-hook.cjs\"",
            "timeout": 10,
            "statusMessage": "Checking GitNexus index freshness..."
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "pgrep -f 'gitnexus mcp' | while read -r p; do [ \"$(ps -o ppid= -p \"$p\" 2>/dev/null | tr -d ' ')\" = \"1\" ] && kill -9 \"$p\" 2>/dev/null; done; true",
            "timeout": 10,
            "statusMessage": "Reaping orphaned gitnexus MCP processes...",
            "async": true
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"__HOME__/Developer/agent-tab-title/bin/agent-tab-title.js\" claude"
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "# sounds.sh: soundsh/minecraft-eating\nafplay \"__HOME__/.claude/sounds/soundsh--minecraft-eating.mp3\"",
            "async": true
          }
        ]
      },
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 __HOME__/Developer/vini-personal/hooks/verification_before_completion.py"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"__HOME__/Developer/agent-tab-title/bin/agent-tab-title.js\" claude"
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "frontend-design@claude-plugins-official": true,
    "devloop@devloop-local": true
  },
  "extraKnownMarketplaces": {
    "devloop-local": {
      "source": {
        "source": "directory",
        "path": "__HOME__/Developer/devloop-plugin-src"
      }
    }
  },
  "language": "pt-BR — português do Brasil. NUNCA português de Portugal: use 'você', gerúndio ('estou fazendo', nunca 'estou a fazer'), e o léxico brasileiro (tela/arquivo/usuário/time/celular/trem, nunca ecrã/ficheiro/utilizador/equipa/telemóvel/comboio).",
  "effortLevel": "xhigh",
  "voice": {
    "enabled": true,
    "mode": "hold"
  },
  "skipDangerousModePermissionPrompt": true,
  "remoteControlAtStartup": false,
  "agentPushNotifEnabled": true,
  "voiceEnabled": true,
  "contextCompactionThreshold": 80
}
